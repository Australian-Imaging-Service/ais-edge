#!/usr/bin/env bash
# Stub curl for the cleaner-activation harness: the SeaweedFS filer behind the
# port-forward. Records the call and answers with a status code and a body, the
# way curl's -o/-w/-f present them. The bucket listing comes from the attributes
# the case's PUTs wrote (attrs.<bucket>.json); ?tagging answers 202 (tagging.fail:
# 500; tagging.ignore: 202 but nothing stored); .uploads/ answers 404 unless
# uploads.<bucket>.json (200 with that body) or uploads.code.<bucket> (that code)
# exists, and uploads.fail makes curl itself fail with the exit code in it.
S="${SCENARIO:?SCENARIO required}"
method=GET; url=""; hdr=""; out=""; wfmt=""; fail=0; args=("$@"); i=0
while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
        -X) i=$((i + 1)); method="${args[$i]}" ;;
        -H) i=$((i + 1)); case "${args[$i]}" in Accept:*) ;; *) hdr="${args[$i]}" ;; esac ;;
        -o) i=$((i + 1)); out="${args[$i]}" ;;
        -w) i=$((i + 1)); wfmt="${args[$i]}" ;;
        -m) i=$((i + 1)) ;;
        -f) fail=1 ;;
        http://*) url="${args[$i]}" ;;
    esac
    i=$((i + 1))
done
path=${url#http://127.0.0.1:1}
echo "curl $method $path${hdr:+ $hdr}" >> "$S/calls.log"
code=200; body=""
case "$method $path" in
    "PUT /buckets/"*"?tagging")
        b=${path#/buckets/}; b=${b%%\?*}
        if [ -f "$S/tagging.fail" ]; then code=500
        elif [ ! -f "$S/tagging.ignore" ]; then
            code=202
            python3 - "$S/attrs.$b.json" "$hdr" <<'PY'
import json, sys
p, h = sys.argv[1:3]
k, v = h.split(": ", 1)
d = json.load(open(p)); d[k] = v; json.dump(d, open(p, "w"))
PY
        else code=202; fi ;;
    "GET /buckets/?limit=1000")
        body=$(python3 - "$S" <<'PY'
import base64, glob, json, os, sys
S = sys.argv[1]; entries = []
for p in sorted(glob.glob(os.path.join(S, "attrs.*.json"))):
    b = os.path.basename(p)[6:-5]
    d = json.load(open(p))
    entries.append({"FullPath": "/buckets/" + b,
                    "Extended": {k: base64.b64encode(v.encode()).decode() for k, v in d.items()} or None})
print(json.dumps({"Entries": entries}))
PY
        ) ;;
    "GET /buckets/"*"/.uploads/?limit=1")
        b=${path#/buckets/}; b=${b%%/*}
        [ -f "$S/uploads.fail" ] && { echo "stub curl: connection failed" >&2; exit "$(cat "$S/uploads.fail")"; }
        if [ -f "$S/uploads.code.$b" ]; then code=$(cat "$S/uploads.code.$b")
        elif [ -f "$S/uploads.$b.json" ]; then body=$(cat "$S/uploads.$b.json")
        else code=404; body='{"error":"not found"}'; fi ;;
    *) echo "stub curl: unexpected call: $method $path" >&2; exit 1 ;;
esac
[ "$fail" = 1 ] && [ "$code" -ge 400 ] && exit 22
if [ -n "$out" ]; then printf '%s' "$body" > "$out"; else printf '%s' "$body"; fi
[ -n "$wfmt" ] && printf '%s' "$code"
exit 0
