#!/usr/bin/env bash
# Stub kubectl for the cleaner-activation harness. Records the call, answers from
# the case's fixtures (see run-tests.sh), and fails on anything not configured.
# The edge of a call is the suffix of its --kubeconfig path (kubeconfig-<edge>).
S="${SCENARIO:?SCENARIO required}"
echo "kubectl $*" >> "$S/calls.log"
args=("$@"); rest=(); i=0; EDGE=""
while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
        --kubeconfig) EDGE="${args[$((i + 1))]##*kubeconfig-}"; i=$((i + 2)); continue ;;
        -n) i=$((i + 2)); continue ;;
    esac
    rest+=("${args[$i]}"); i=$((i + 1))
done
set -- "${rest[@]}"
count() {   # <name>: the number of times this call was made so far, in a file
    local f="$S/count.$1" n; n=$(cat "$f" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$f"; echo "$n"
}
annotate() {   # <ann file> <key=value | key->: the annotations of an object, kept as JSON
    python3 - "$1" "$2" <<'PY'
import json, os, sys
p, kv = sys.argv[1:3]
d = json.load(open(p)) if os.path.exists(p) else {}
if kv.endswith("-"): d.pop(kv[:-1], None)
else: k, v = kv.split("=", 1); d[k] = v
json.dump(d, open(p, "w"))
PY
}
asjson() {   # <spec json> <ann file>: the object as `get -o json` prints it
    python3 -c 'import json, os, sys; a = json.load(open(sys.argv[2])) if os.path.exists(sys.argv[2]) else {}
print(json.dumps({"spec": json.loads(sys.argv[1]), "metadata": {"annotations": a}}))' "$1" "$2"
}
case "${1:-} ${2:-}" in
    "patch cronjob")
        printf '%s' "$*" | grep -o '"suspend":[a-z]*' | cut -d: -f2 > "$S/cronjob.$3.suspend"; exit 0 ;;
    "annotate cronjob") annotate "$S/ann.cronjob.$3.json" "$4"; exit 0 ;;
    "get cronjob/"*)
        n=${2#cronjob/}; asjson "{\"suspend\": $(cat "$S/cronjob.$n.suspend" 2>/dev/null || echo false)}" "$S/ann.cronjob.$n.json"; exit 0 ;;
    "get cronjob")
        case "$*" in
            *suspend*)   cat "$S/cronjob.$3.suspend" 2>/dev/null || echo false; exit 0 ;;
            *S3_BUCKET*) echo "ingest-${3#mgmt-reclaim-}"; exit 0 ;;
        esac
        exit 1 ;;
    "annotate deployment.apps/$EDGE-s3-uploader") annotate "$S/ann.deploy.$EDGE.json" "$3"; exit 0 ;;
    "get jobs") cat "$S/jobs.json"; exit 0 ;;
    "get pods")
        case "$*" in
            *component=s3-uploader*)
                [ -f "$S/uploader-pods.fail" ] && { echo "stub: the edge API is unavailable" >&2; exit 1; }
                cat "$S/uploader-pods"; exit 0 ;;
            *) cat "$S/pods.json"; exit 0 ;;
        esac ;;
    "get deploy")
        n=$(count deploy-list)
        [ "$(cat "$S/deploy-list.fail-on" 2>/dev/null)" = "$n" ] && { echo "stub: the edge API is unavailable" >&2; exit 1; }
        echo "deployment.apps/$EDGE-s3-uploader"; exit 0 ;;
    "get deployment.apps/$EDGE-s3-uploader")
        n=$(count deploy-get.$EDGE)
        [ "$(cat "$S/deploy-get.fail-on.$EDGE" 2>/dev/null)" = "$n" ] && { echo "stub: the edge API is unavailable" >&2; exit 1; }
        [ "$(cat "$S/deploy-get.garbage-on.$EDGE" 2>/dev/null)" = "$n" ] && { echo "not json"; exit 0; }
        asjson "{\"replicas\": $(cat "$S/replicas.$EDGE" 2>/dev/null || echo 1)}" "$S/ann.deploy.$EDGE.json"; exit 0 ;;
    "scale deployment.apps/$EDGE-s3-uploader")
        n=$(count scale.$EDGE)
        [ -f "$S/scale.fail.$EDGE" ] && exit 1
        [ "$(cat "$S/scale.fail-on.$EDGE" 2>/dev/null)" = "$n" ] && exit 1
        exit 0 ;;
    "rollout restart")
        [ -f "$S/rollout.fail" ] && exit 1
        [ -f "$S/attrs.reset-on-rollout" ] && printf '{}' > "$S/attrs.ingest-edge-a.json"   # the attribute did not persist
        exit 0 ;;
    "rollout status") [ -f "$S/rollout.fail" ] && exit 1; exit 0 ;;
    "port-forward svc/mgmt-seaweedfs") echo "Forwarding from 127.0.0.1:1 -> 8888"; sleep 30; exit 0 ;;
esac
echo "stub kubectl: unexpected call: $*" >&2
exit 1
