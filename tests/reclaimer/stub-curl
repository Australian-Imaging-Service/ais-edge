#!/usr/bin/env bash
# Stub `curl` for the reclaimer harness.
#
# Handles the three things the reclaimer uses curl for: the filer readiness
# probe, the filer DELETE, and the XNAT REST queries. For XNAT it also keeps
# sessions and certificate checks the way the real server and real curl do, so
# a case can count the sessions a run leaves open.
#
# THE DELETE IS RECORDED, and that recording is the point of the whole
# harness. Almost every assertion is ultimately "did a DELETE happen for this
# session, yes or no" — the log line is secondary, because a reclaimer that
# logs `reclaim_kept` and deletes anyway is the failure that matters.
set -uo pipefail
S="${SCENARIO:?SCENARIO required}"
CALLS="${S}/calls.log"
DELETES="${S}/deletes.log"

url=""; method="GET"; insecure=0; has_w=0
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
    a="${args[$i]}"
    case "$a" in
        -X) i=$((i+1)); method="${args[$i]}" ;;
        # `-K -` tells real curl to read its config from STDIN, which is how the
        # reclaimer passes XNAT credentials without putting them on argv. This stub
        # ignored stdin and exited, so the `printf` feeding it took SIGPIPE and bash
        # printed `printf: write error: Broken pipe`. It is a race: on a fast machine
        # printf finishes before the stub exits and nothing is printed, which is why
        # this passed locally and only failed on a CI runner. Drain it, as curl would.
        -K) i=$((i+1)); [ "${args[$i]}" = "-" ] && drain_stdin=1 ;;
        -k|--insecure) insecure=1 ;;
        -w) i=$((i+1)); has_w=1 ;;
        http://*|https://*) url="$a" ;;
    esac
    i=$((i+1))
done
conf=""
[ "${drain_stdin:-0}" = "1" ] && conf=$(cat 2>/dev/null)
echo "curl $method $url$([ "$insecure" = 1 ] && echo ' insecure')" >> "$CALLS"

emit() { printf '%s' "$1"; printf '\n%s' "$2"; }   # body then \n<code>, matching -w

# ---- filer -----------------------------------------------------------------
case "$url" in
*:8888*)
    if [ "$method" = "DELETE" ]; then
        [ -f "$S/filer-delete.fail" ] && { printf 'HTTP 500'; printf '\n500'; exit 0; }
        # Record the session whose prefix was deleted.
        printf '%s\n' "$url" | sed 's#.*/staged/##; s#?.*##' >> "$DELETES"
        printf ''; printf '\n204'; exit 0
    fi
    # readiness probe (-w '%{http_code}' only, no body)
    [ -f "$S/filer-down.fail" ] && exit 1
    [ -f "$S/filer-500" ] && { printf '500'; exit 0; }
    printf '200'; exit 0 ;;
esac

# ---- XNAT ------------------------------------------------------------------
# XNAT's certificate does not verify here, as on the tier-1 test edge: that is
# why every case runs with XNAT_VERIFY_SSL=false. Real curl then refuses an
# https call without -k (exit 60, and -w still prints 000). xnat-cert-trusted
# lifts this, for a case that runs with verification on.
case "$url" in https://*)
    if [ "$insecure" = 0 ] && [ ! -f "$S/xnat-cert-trusted" ]; then
        echo "curl: (60) SSL certificate problem: self-signed certificate in certificate chain" >&2
        [ "$has_w" = 1 ] && printf '\n000'
        exit 60
    fi ;;
esac

# SESSIONS, as the real server keeps them (checked on xnat-test 2026-10-14): a
# request with the credentials (`user = ...`) opens a NEW session whatever its
# URL, and XNAT keeps it until it times out; a JSESSIONID cookie reuses an open
# one; DELETE /data/JSESSION closes it, and the cookie then gets 401.
SESSIONS="$S/xnat-sessions.log"
cookie=$(printf '%s\n' "$conf" | sed -n 's/^header = "Cookie: JSESSIONID=\(.*\)"$/\1/p')
if printf '%s\n' "$conf" | grep -q '^user = '; then
    [ -f "$S/xnat-auth.fail" ] && { emit '<html>401</html>' '401'; exit 0; }
    case "$method $url" in "GET "*/data/JSESSION)
        [ -f "$S/xnat-jsession.fail" ] && { emit '<html>500</html>' '500'; exit 0; } ;;
    esac
    sid="S$(( $(cat "$SESSIONS" 2>/dev/null | grep -c '^SESSION-OPENED') + 1 ))"
    echo "SESSION-OPENED $sid" >> "$SESSIONS"
elif [ -n "$cookie" ] && grep -qx "SESSION-OPENED $cookie" "$SESSIONS" 2>/dev/null \
        && ! grep -qx "SESSION-CLOSED $cookie" "$SESSIONS"; then
    sid="$cookie"
else
    emit '<html>401</html>' '401'; exit 0
fi
# The token goes to xnat-shared-session too: the Python helper borrows the run's
# session, and fake-xnat.py accepts that token. xnat-logout.fail makes the logout
# answer 500 and keep the session, as a server fault would.
case "$method $url" in
"GET "*/data/JSESSION)    printf '%s' "$sid" > "$S/xnat-shared-session"; emit "$sid" '200'; exit 0 ;;
"DELETE "*/data/JSESSION) [ -f "$S/xnat-logout.fail" ] && { emit '<html>500</html>' '500'; exit 0; }
                          echo "SESSION-CLOSED $sid" >> "$SESSIONS"; rm -f "$S/xnat-shared-session"; emit '' '200'; exit 0 ;;
esac

case "$url" in
*/data/projects\?format=json*)
    [ -f "$S/xnat-auth.fail" ] && { emit '<html>401</html>' '401'; exit 0; }
    emit '{"ResultSet":{"Result":[]}}' '200'; exit 0 ;;

*/experiments\?format=json*)
    sub=$(printf '%s' "$url" | sed 's#.*/subjects/##; s#/experiments.*##')
    [ -f "$S/xnat-exp.${sub}.fail" ] && { emit '<html>500</html>' '500'; exit 0; }
    if [ -f "$S/xnat-exp.${sub}.json" ]; then
        emit "$(cat "$S/xnat-exp.${sub}.json")" '200'; exit 0
    fi
    emit '{"ResultSet":{"Result":[]}}' '200'; exit 0 ;;

# RECORDED FROM THE REAL SERVER, 2026-09-01. Every file-listing endpoint
# answers 200 with an empty Result — for COMPLETE sessions as well as empty
# ones. It is not configurable from a fixture on purpose: a stub that can be
# told to return file rows models an XNAT that does not exist, and that is
# exactly why a probe which could never confirm anything passed 31/31 tests.
*/files\?format=json*)
    emit '{"ResultSet":{"Columns":[{"key":"URI","serverRoot":""}],"Result":[], "title": "Files"}}' '200'; exit 0 ;;

*/scans\?format=json*)
    exp=$(printf '%s' "$url" | sed 's#.*/experiments/##; s#/scans.*##')
    [ -f "$S/xnat-scans.${exp}.fail" ] && { emit '<html>500</html>' '500'; exit 0; }
    if [ -f "$S/xnat-scans.${exp}.json" ]; then
        emit "$(cat "$S/xnat-scans.${exp}.json")" '200'; exit 0
    fi
    emit '{"ResultSet":{"Result":[]}}' '200'; exit 0 ;;

# file_count and file_size are STRINGS in the real payload, and empty when XNAT
# has not built the stats. Fixtures must keep them strings.
*/resources\?format=json*)
    exp=$(printf '%s' "$url" | sed 's#.*/experiments/##; s#/scans.*##')
    sid=$(printf '%s' "$url" | sed 's#.*/scans/##; s#/resources.*##')
    [ -f "$S/xnat-res.${exp}.${sid}.fail" ] && { emit '<html>500</html>' '500'; exit 0; }
    if [ -f "$S/xnat-res.${exp}.${sid}.json" ]; then
        emit "$(cat "$S/xnat-res.${exp}.${sid}.json")" '200'; exit 0
    fi
    emit '{"ResultSet":{"Result":[]}}' '200'; exit 0 ;;
esac

emit '' '404'
exit 0
