#!/usr/bin/env bash
# =============================================================================
# Tier-1 (single-node) configuration
# =============================================================================
# One machine runs the whole pipeline:
#   Orthanc (DICOM receive + deid) -> xnat-ingest group-orthanc -> assign ->
#   upload -> XNAT (HTTPS). No SeaweedFS, no k0smotron, no separate edge worker, no
#   cloud LB. Observability (Loki/Prometheus/Grafana/Alertmanager/Vector) runs
#   locally on the same node.
#
# Minimum to fill in before ./install.sh — search for "# REQUIRED":
#   1. MGMT_NODE_IP
#   2. XNAT_URL / XNAT_USER / XNAT_PASS
#   3. PROJECT_ID            (XNAT project the sessions land in — must exist)
#   4. AIS_DEID_HMAC_SALT    (openssl rand -hex 32)
#
# Optional: ALERT_EMAIL_TO + ALERT_SMTP_* enable logging/metrics/alerting.
# Everything else has sane defaults.
# =============================================================================

# --- Node ---
export MGMT_NODE_IP=""                         # REQUIRED — this machine's IP

# --- XNAT target ---
export XNAT_URL=""                             # REQUIRED — e.g. https://xnat.example.org
export XNAT_USER=""                            # REQUIRED — XNAT local service account
export XNAT_PASS=""                            # REQUIRED
export PROJECT_ID=""                           # REQUIRED — XNAT project ID (must exist)

# --- Installation mode ---
# "fresh"    - install k0s from scratch on this machine
# "existing" - use an already-running single-node Kubernetes cluster
#              (ensure kubectl is configured and ~/.kube/config points at it)
export INSTALL_MODE="fresh"

# --- Ingest tuning ---
export INGEST_LOOP_SECONDS="60"                # group/assign poll interval
export INGEST_WAIT_PERIOD="60"                 # quiet period before a study is staged

# --- Images ---
# Upstream xnat-ingest (all AIS-Edge changes merged upstream). Pipeline stages:
# group-orthanc (Orthanc REST-pull) -> assign (project/subject/session IDs) ->
# upload (LOCAL staging dir -> XNAT). De-id is done in Orthanc, so the optional
# upstream `deidentify` stage is not used here.
export XNAT_INGEST_IMAGE="ghcr.io/australian-imaging-service/xnat-ingest:0.12.3"
# Orthanc >= 1.12.0 required for study-level labels used by the deid hook.
export ORTHANC_IMAGE="jodogne/orthanc-plugins:1.12.6"

# --- De-identification ---
# HMAC salt the Orthanc deid Lua hook uses to derive SubjectHash/SessionHash
# from the original PatientID + StudyInstanceUID. Generate once per
# deployment and keep it stable (rotating changes the deid'd identity for the
# same patient): openssl rand -hex 32
export AIS_DEID_HMAC_SALT=""                    # REQUIRED — openssl rand -hex 32

# --- Observability (optional) ---
# If ALERT_EMAIL_TO is empty, the observability step is skipped cleanly and
# the pipeline works without it. On a single node the stack is native:
#   * Loki uses LOCAL FILESYSTEM storage (the single-binary standard) on a PVC
#   * Vector tails all pod logs and pushes to the in-cluster Loki (no 443/SNI)
#   * Grafana is exposed on a NodePort — http://MGMT_NODE_IP:GRAFANA_NODEPORT
#   * Prometheus + Alertmanager as today; same dashboards + alert rules
export OBSERVABILITY_RETENTION_DAYS="30"        # log + metric retention (disk-bound)
export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD="grafana-admin-change-me"
export GRAFANA_NODEPORT="30030"                 # Grafana UI at http://MGMT_NODE_IP:30030

# --- Alert routing ---
# Consumed by 02d-install-observability.sh. SMTP password stored as a Secret.
export ALERT_EMAIL_TO=""                        # set to enable observability
export ALERT_EMAIL_FROM="ais-edge-alerts@example.com"
export ALERT_SMTP_HOST=""                       # e.g. smtp.gmail.com
export ALERT_SMTP_PORT="587"                    # 587=STARTTLS, 465=TLS, 25=plain
export ALERT_SMTP_USERNAME=""                   # blank for unauthenticated relays
export ALERT_SMTP_PASSWORD=""
export ALERT_SMTP_REQUIRE_TLS="true"            # true | false (rarely false)
export ALERT_SLACK_WEBHOOK=""                   # optional Slack incoming-webhook
