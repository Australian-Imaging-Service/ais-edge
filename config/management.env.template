#!/usr/bin/env bash
# =============================================================================
# Management Cluster Configuration
# =============================================================================
# This file configures the central management node that runs:
#   - k0s (or can use existing k3s/kubeadm/etc)
#   - k0smotron operator
#   - SeaweedFS (S3-compatible storage)
#   - XNAT upload pod
#
# Minimum to fill in before running ./install.sh — search for "# REQUIRED":
#   1. MGMT_NODE_IP
#   2. XNAT_URL / XNAT_USER / XNAT_PASS
#   3. S3_ADMIN_ACCESS_KEY / S3_ADMIN_SECRET_KEY  (change the defaults!)
#   4. AIS_DEID_HMAC_SALT  (openssl rand -hex 32)
#
# Optional (only if you want centralised logging/metrics):
#   * ALERT_EMAIL_TO + ALERT_SMTP_* — enables Loki/Prom/Grafana/Alertmanager
#
# Everything else has sane defaults.
# =============================================================================

# --- Management Node ---
export MGMT_NODE_IP=""                        # REQUIRED — public IP of this machine

# --- SeaweedFS S3 storage ---
# Admin credentials for the S3 API (used by the management upload pod and admin tools)
export S3_ADMIN_ACCESS_KEY="seaweedadmin"                       # REQUIRED — change defaults
export S3_ADMIN_SECRET_KEY="seaweedadmin-change-me-please"      # REQUIRED — change defaults
export S3_BUCKET="ingest-bucket"              # Bucket for staged DICOM sessions

# Phase 2: SeaweedFS is exposed via nginx-ingress at https://${SEAWEEDFS_HOSTNAME}
# (TLS-terminated, signed by ais-edge-ca). The Service is ClusterIP only.
# Master/filer admin UIs are reachable via `kubectl port-forward`.
# These three NodePort vars are NO LONGER USED in Phase 2 — kept here so old
# configs don't break, and the README still references the legacy mode.
export S3_NODEPORT="31090"                    # legacy (Phase 1) — unused
export MASTER_NODEPORT="31091"                # legacy (Phase 1) — unused
export FILER_NODEPORT="31092"                 # legacy (Phase 1) — unused

# --- XNAT Target ---
export XNAT_URL=""                            # REQUIRED — e.g. https://xnat.example.com
export XNAT_USER=""                           # REQUIRED — XNAT local service account username
export XNAT_PASS=""                           # REQUIRED — XNAT local service account password

# --- Installation Mode ---
# "fresh"    - install k0s from scratch on this machine
# "existing" - use an already-running Kubernetes cluster (k3s, kubeadm, etc.)
#              when "existing", ensure kubectl is configured and ~/.kube/config is set
export INSTALL_MODE="fresh"

# --- TLS / SNI routing ---
# All edge ↔ management traffic flows over a single TLS port (default 443).
# nginx-ingress on the management cluster terminates the connection (with
# SSL passthrough) and routes by SNI to the right backend.
#
# Two topologies are supported (see INSTALL_TOPOLOGY below):
#   onprem  — nginx-ingress binds the mgmt node's host port via hostNetwork.
#             Hostname resolution is via hostAliases inside each pod plus
#             /etc/hosts on every edge worker (both pointing at MGMT_NODE_IP).
#             Zero DNS infrastructure required. Default for air-gapped sites
#             and the original deployment shape.
#   cloud   — nginx-ingress is exposed as a Service type LoadBalancer; the
#             cloud provider (Octavia/NLB/Azure LB/GCP LB) provisions a real
#             LB and gives it a public IP (LB_PUBLIC_IP, below). Hostname
#             resolution is via real public DNS. No /etc/hosts hacks, no
#             hostAliases. Required for managed-K8s (EKS/AKS/GKE/Magnum)
#             where you cannot bind hostNetwork on cluster nodes.
export INSTALL_TOPOLOGY="onprem"               # onprem | cloud

# Hostname suffix all SNI routes derive from. The on-prem default is the
# legacy local domain.
#
# For a cloud-mode dev test on Nectar (or any cloud where you don't yet
# own a real DNS zone) use a nip.io wildcard like
#   dev-nectar-test.<LB_PUBLIC_IP-with-dashes>.nip.io
# e.g. dev-nectar-test.203-101-227-222.nip.io — nip.io resolves any subdomain
# of that pattern to the embedded IP. No DNS registration needed.
# See docs/cloud-deployment.md for the full topology.
#
# For production set this to the real DNS zone you own
# (e.g. aisedge.uq.edu.au). Switching from the nip.io dev suffix to a real
# production zone is a single-line change — every other reference
# (LOKI_HOSTNAME, cert SANs, dashboard vars) is derived from this.
export INTERNAL_DOMAIN="aisedge.local"
export SEAWEEDFS_HOSTNAME="seaweedfs.${INTERNAL_DOMAIN}"
export K0S_API_HOSTNAME="k0s.${INTERNAL_DOMAIN}"
export KONNECTIVITY_HOSTNAME="konnect.${INTERNAL_DOMAIN}"
export INGRESS_PORT="443"

# --- Cloud-mode specifics (only used when INSTALL_TOPOLOGY=cloud) ---
# Pre-allocated public IP that the cloud LB will be assigned. On OpenStack
# this is a floating IP allocated in the project before install. On AWS/GCP/
# Azure you can leave blank and let the cloud controller provision one — but
# you then have to wait for the LB to come up to discover its address before
# you can set the DNS records. Pre-allocating is operationally simpler.
export LB_PUBLIC_IP=""

# Which cert-manager ClusterIssuer signs the public-facing certs (Loki,
# SeaweedFS, Grafana, the k0s API SNI, konnectivity).
#   ais-edge-ca         — our self-signed root, mounted into edge pods as
#                         ca-bundle Secret. Works offline; required for
#                         nip.io dev domains because Let's Encrypt blocks
#                         them.
#   letsencrypt-prod    — Let's Encrypt production via DNS-01 challenge.
#                         Real public CA — no CA distribution to edges
#                         needed. Requires DNS_PROVIDER configured (below).
#   letsencrypt-staging — Let's Encrypt staging — fake CA, untrusted by
#                         browsers but useful for end-to-end DNS-01 testing
#                         without burning real-rate-limit quota.
export CERT_ISSUER="ais-edge-ca"

# DNS provider for the cert-manager DNS-01 solver (only needed when
# CERT_ISSUER=letsencrypt-*). Format depends on the provider. Examples:
#   DNS_PROVIDER="cloudflare"   — also set CLOUDFLARE_API_TOKEN
#   DNS_PROVIDER="route53"      — also set AWS_ROUTE53_HOSTED_ZONE_ID
#   DNS_PROVIDER="rfc2136"      — for self-hosted BIND etc.
export DNS_PROVIDER=""

# --- xnat-ingest image ---
# We currently run a fork that adds (a) AIS_LOG_FORMAT=json output and
# (b) a fix for an upstream `upload --loop` memory leak that previously
# triggered global-OOM cascades on the mgmt VM every ~30 hours..
# Image is pushed to ghcr.io as public so kubelet pulls it anonymously.
#
# When upstream merges both patches, switch this single line to the
# upstream tag:
#   export XNAT_INGEST_IMAGE="ghcr.io/australian-imaging-service/xnat-ingest:latest"
# and re-run ./install.sh -y. Every pod will be rolled with the new image.
# No other code changes needed.
#
# v0.1.0 (current default) is `logging-v3` PLUS the Orthanc REST-pull mode
# used by the edge sort pod.
# patch inventory.
export XNAT_INGEST_IMAGE="ghcr.io/aswinnarayanan/xnat-ingest:v0.1.0"

# --- Orthanc DICOM receiver (edge-side) ---
# Orthanc accepts C-STORE from local modalities, runs the AIS Lua hook
# (deidentify-and-forward.lua), keeps deid'd instances in its storage tree.
# xnat-ingest sort REST-pulls from Orthanc and hardlinks into staging.
#
# Image needs Orthanc >= 1.12.0 for label support (study-level labels are how
# the deid hook signals to sort that a study is ready to ingest).
export ORTHANC_IMAGE="jodogne/orthanc-plugins:1.12.6"

# HMAC salt used by the deid Lua hook to derive SubjectHash and SessionHash
# from the original PatientID + StudyInstanceUID. Generate once per
# deployment (`openssl rand -hex 32`) and store securely — rotating means a
# different deid'd identity for the same patient.
export AIS_DEID_HMAC_SALT=""                  # REQUIRED — openssl rand -hex 32

# --- Observability stack (logs + metrics + alerts) ---
# Optional. If ALERT_EMAIL_TO is empty the observability install steps
# (02d, 07b) skip cleanly and the rest of the system works without it.
# When ALERT_EMAIL_TO is set, the install:
#   * deploys Loki + Prometheus + Grafana + Alertmanager + Vector to the
#     management cluster (in the 'observability' namespace)
#   * adds two SNI routes to the existing :443 nginx-ingress:
#       https://${GRAFANA_HOSTNAME}     site-admin browser, dashboards UI
#       https://${LOKI_HOSTNAME}        Vector push endpoint from edges
#   * pushes a Vector DaemonSet to each edge child cluster so logs from
#     every pod (xnat-ingest sort, s3-uploader, system pods) flow back
#     to the central Loki on the same single 443 outbound port.
export GRAFANA_HOSTNAME="grafana.${INTERNAL_DOMAIN}"
export LOKI_HOSTNAME="loki.${INTERNAL_DOMAIN}"

# Grafana local-admin user (no SSO yet). Change before exposing externally.
export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD="grafana-admin-change-me"

# Days of log + metric retention. Disk-bound — logs land in SeaweedFS
# logs-bucket, metrics in a local 20Gi PV.
export OBSERVABILITY_RETENTION_DAYS="30"

# SeaweedFS bucket Loki writes to (kept separate from the DICOM
# ingest-bucket so retention/lifecycle policies don't intermix).
export LOGS_BUCKET="logs-bucket"
export LOKI_S3_ACCESS_KEY="loki-writer"
export LOKI_S3_SECRET_KEY="loki-writer-secret-change-me"

# --- Alert routing ---
# Where Alertmanager sends pipeline alerts (stalled sessions, retry storms,
# disk-full warnings, certificate expiry, konnectivity tunnel drops).
# These values are consumed by 02d-install-observability.sh; until then
# they are inert. The SMTP password is stored as a Kubernetes Secret at
# install time.
export ALERT_EMAIL_TO=""                              # e.g. ais-edge-ops@uq.edu.au
export ALERT_EMAIL_FROM="ais-edge-alerts@example.com" # From: header in alert emails
export ALERT_SMTP_HOST=""                             # e.g. smtp.gmail.com
export ALERT_SMTP_PORT="587"                          # 587=STARTTLS, 465=TLS, 25=plain
export ALERT_SMTP_USERNAME=""                         # leave blank for unauthenticated relays
export ALERT_SMTP_PASSWORD=""                         # stored as a Secret at install
export ALERT_SMTP_REQUIRE_TLS="true"                  # true | false (rarely false)

# Optional second receiver — Slack incoming-webhook URL (leave blank to disable).
# When set, the same alerts also post to the configured Slack channel.
export ALERT_SLACK_WEBHOOK=""
