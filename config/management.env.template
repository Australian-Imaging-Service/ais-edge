#!/usr/bin/env bash
# =============================================================================
# Management Cluster Configuration
# =============================================================================
# This file configures the central management node that runs:
#   - k0s (or can use existing k3s/kubeadm/etc)
#   - k0smotron operator
#   - MinIO (S3-compatible storage)
#   - XNAT upload pod
# =============================================================================

# --- Management Node ---
export MGMT_NODE_IP=""                        # Public IP of this machine

# --- MinIO ---
export MINIO_ROOT_USER="minioadmin"           # MinIO admin (change in production!)
export MINIO_ROOT_PASSWORD="minioadmin123"    # MinIO admin password (change!)
export MINIO_BUCKET="ingest-bucket"           # Bucket for staged files
export MINIO_NODEPORT="31090"                 # NodePort for MinIO S3 API
export MINIO_CONSOLE_NODEPORT="31091"         # NodePort for MinIO web console

# --- XNAT Target ---
export XNAT_URL=""                            # e.g. https://xnat.example.com
export XNAT_USER=""                           # XNAT local service account username
export XNAT_PASS=""                           # XNAT local service account password

# --- Installation Mode ---
# Set to "fresh" to install k0s from scratch on this machine
# Set to "existing" to use an already-running Kubernetes cluster (k3s, kubeadm, etc)
# When "existing", ensure kubectl and helm are installed and ~/.kube/config is set
export INSTALL_MODE="fresh"                   # "fresh" or "existing"
