#!/usr/bin/env bash
# =============================================================================
# Edge Node Configuration
# =============================================================================
# Define all edge nodes here. Each node gets its own hosted k0s cluster
# managed by k0smotron, and its own scoped S3 access keys to SeaweedFS.
#
# Format: One line per edge site with pipe-separated fields:
#   CLUSTER_NAME|NODE_IP|SSH_USER|SSH_KEY|PROJECT_ID|S3_ACCESS_KEY|S3_SECRET_KEY
#
# Fields:
#   CLUSTER_NAME    - Unique name for this edge cluster (e.g. edge-uqcai)
#   NODE_IP         - Public IP of the edge worker VM
#   SSH_USER        - SSH user on the edge VM (usually ubuntu)
#   SSH_KEY         - Path to SSH private key for this node
#   PROJECT_ID      - Default XNAT project ID for ingested data
#   S3_ACCESS_KEY   - SeaweedFS access key for this edge (scoped: write+list on bucket)
#   S3_SECRET_KEY   - SeaweedFS secret key for this edge
#
# Each edge node gets:
#   - Its own k0smotron hosted cluster (separate control plane)
#   - Its own scoped S3 credentials (write to ingest-bucket only — isolated per site)
#   - Its own xnat-ingest sort + s3-uploader pods
#
# Example with multiple sites:
# EDGE_NODES=(
#   "edge-uqcai|203.101.230.171|ubuntu|~/.ssh/id_ed25519|uqcai-project|uqcai-edge-key|uqcai-secret-change-me"
#   "edge-usyd|10.0.1.50|ubuntu|~/.ssh/id_ed25519|usyd-project|usyd-edge-key|usyd-secret-change-me"
#   "edge-newcastle|10.0.2.50|ubuntu|~/.ssh/id_ed25519|newcastle-project|newcastle-edge-key|newcastle-secret-change-me"
# )
# =============================================================================

EDGE_NODES=(
  "edge-dev|203.101.230.171|ubuntu|~/.ssh/id_ed25519|test-project|edge-writer|edge-writer-secret-change-me"
)

# --- Shared Edge Settings ---
export INGEST_LOOP_SECONDS="60"               # How often sort/upload checks for new data
export INGEST_WAIT_PERIOD="60"                # Seconds to wait for stable sessions before staging
