{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "stat",
      "title": "Last upload (cluster=$cluster)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "time() - max(ais_pipeline_events_total{cluster=\"$cluster\",event=\"upload_completed\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "Pod restarts (xnat-ingest ns) — 1h",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"xnat-ingest\"}[1h]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Worker NotReady?",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "CPU and memory usage (xnat-ingest pods)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"xnat-ingest\"}[5m]))", "legendFormat": "cpu/{{pod}}", "refId": "A" },
        { "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"xnat-ingest\"}) / 1024 / 1024", "legendFormat": "mem(MiB)/{{pod}}", "refId": "B" }
      ]
    },
    {
      "type": "logs",
      "title": "Live log tail — xnat-ingest pods on $cluster",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{cluster=\"$cluster\",namespace=\"xnat-ingest\"}", "refId": "A" }],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ais-edge", "edge-site"],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(ais_pipeline_events_total, cluster)",
        "refresh": 1,
        "current": { "value": "" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "AIS Edge — Edge Site Drilldown",
  "uid": "ais-edge-drilldown",
  "version": 1
}
