{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "stat",
      "title": "Completed XNAT uploads (last 10m, cluster=$cluster / node=$node)",
      "description": "Count of successful XNAT uploads ('Successfully uploaded all files in' log lines) in the last 10 minutes, scoped by the dashboard's cluster + node filters. 0 with active scanners likely means the pipeline is stuck — drill into the panels below.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",namespace=\"xnat-upload\",component=\"upload\"} |~ \"Successfully uploaded all files in\" [10m]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"green","value":1}] } } }
    },
    {
      "type": "stat",
      "title": "Assign errors (last 1h, cluster=$cluster / node=$node)",
      "description": "Count of ERROR-level log lines from the xnat-ingest assign pod in the last hour. Loki-derived because mgmt Prometheus cannot scrape edge clusters (no metrics path across the konnectivity boundary). A non-zero value typically indicates DICOM validation failures or staging errors.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Invalid IDs found.*\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "stat",
      "title": "Upload errors (last 1h, cluster=$cluster / node=$node)",
      "description": "Count of error/failure log lines from the xnat-ingest upload pod. Loki-derived. Prolonged non-zero means the pipeline cannot reach XNAT or the credentials are wrong; see also the Loki ruler alert XNATUploadRetryStorm.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",namespace=\"xnat-upload\",component=\"upload\"} |~ \"(?i)error|failed|exception|traceback\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":1}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "timeseries",
      "title": "XNAT upload log lines per minute (cluster=$cluster / node=$node)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (level) (count_over_time({cluster=\"$cluster\",node=~\"$node\",namespace=\"xnat-upload\",component=\"upload\"} | json | level != \"\" [1m]))",
        "legendFormat": "{{level}}",
        "refId": "A"
      }]
    },
    {
      "type": "logs",
      "title": "Live log tail — xnat-ingest pods on $cluster / $node",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{cluster=\"$cluster\",node=~\"$node\",namespace=\"xnat-ingest\"} | json | line_format \"[{{.component}}] {{if .event}}event={{.event}} {{end}}{{if .session}}session={{.session}} {{end}}{{.message}}\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ais-edge", "edge-site"],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(cluster)",
        "refresh": 1,
        "current": { "value": "edge-dev" }
      },
      {
        "name": "node",
        "label": "Worker node",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({cluster=\"$cluster\"}, node)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "AIS Edge — Edge Site Drilldown",
  "uid": "ais-edge-drilldown",
  "version": 2
}
