{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "logs",
      "title": "Timeline for session $session",
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{namespace=~\"xnat-ingest|xnat-upload\"} |= \"$session\" | json | line_format \"{{.cluster}} | {{.component}} | {{.event}} | {{.message}}\"", "refId": "A" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending" }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["ais-edge", "audit"],
  "templating": {
    "list": [
      {
        "name": "session",
        "type": "textbox",
        "label": "Session name (e.g. test-project.subject01.visit01)",
        "current": { "value": "" },
        "options": []
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "AIS Edge — Session Timeline (audit)",
  "uid": "ais-session-timeline",
  "version": 1
}
