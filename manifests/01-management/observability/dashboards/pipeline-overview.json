{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "DICOMs uploaded (last 1h)",
      "description": "Sum of the `dicoms` field across upload_completed events. Counts only files with .dcm/.DCM suffix. Events from sessions captured before the dicoms counter was added do not contribute (the unwrap directive skips events missing the field) — re-counts settle within 1h of deployment.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_completed\" | unwrap dicoms [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] }, "unit": "short", "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "S3 objects uploaded (last 1h)",
      "description": "Sum of the `files` field across upload_completed events. Includes every object written to S3 — DICOMs AND the per-session MANIFEST.json (and any other staged metadata). Always strictly >= DICOMs uploaded.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_completed\" | unwrap files [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "stat",
      "title": "Sessions uploaded (last 1h)",
      "description": "Count of upload_completed events. One per session that finished mc mirror with exit 0. Each session contains 1 or more DICOMs plus 1 MANIFEST.json.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_completed\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "stat",
      "title": "Upload failures (last 1h)",
      "description": "Count of upload_failed events (mc mirror returned non-zero). 0 = pipeline healthy.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_failed\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":1}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "stat",
      "title": "Invalid sessions (last 1h)",
      "description": "Sessions rejected by xnat-ingest sort because of missing/invalid DICOM headers (e.g. AccessionNumber). These land in /data/staging/__invalid__/ on the edge VM and require a human to rename and re-stage. Each session counts once: we anchor on the per-session error message and ignore the secondary 'Staging completed with N errors' summary line that repeats the same content.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Invalid IDs found.*\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] }, "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Sort cycles with errors (last 1h)",
      "description": "Each xnat-ingest sort cycle that ended with at least one error logs a 'Staging completed with N errors' summary. Counting that summary line gives one tick per failed cycle, regardless of how many sessions were rejected within it. The regex uses (?s) so `.` matches the newlines that follow the colon in the multi-line summary.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"assign\"} | json | message =~ \"(?s)^Staging completed with.*\" [1h]))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "stat",
      "title": "Active edge sites",
      "description": "Distinct cluster labels seen in Loki in the last hour, excluding the management cluster. Grows by 1 each time a new edge starts shipping logs.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(count by (cluster) (count_over_time({cluster!=\"\",cluster!=\"mgmt\"}[1h])))",
        "queryType": "instant",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] }, "unit": "short", "noValue": "0" } }
    },
    {
      "type": "logs",
      "title": "Recent invalid sessions (last 1h)",
      "description": "Each line is a session that xnat-ingest sort routed to /data/staging/__invalid__/. Site-admin action: rename the dir to PROJECT.SUBJECT.VISIT and move it back to /data/staging/.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{namespace=\"xnat-ingest\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Invalid IDs found.*\" | line_format \"{{.cluster}} — {{.message}}\"",
        "refId": "A"
      }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "type": "timeseries",
      "title": "Pipeline events per minute (by event type)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum by (event) (count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json [1m]))", "legendFormat": "{{event}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean","lastNotNull","max"] } }
    },
    {
      "type": "timeseries",
      "title": "Per-edge upload throughput (events/min)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum by (cluster) (count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_completed\" [1m]))", "legendFormat": "{{cluster}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Failure rate (upload_failed / upload_started)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (cluster) (count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_failed\" [15m])) / clamp_min(sum by (cluster) (count_over_time({namespace=\"xnat-ingest\",component=\"s3-uploader\"} | json | event=\"upload_started\" [15m])), 0.001)",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "logs",
      "title": "Recent pipeline events (last 30 min)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{namespace=\"xnat-ingest\"} | json | event != \"\" | line_format \"[{{.cluster}}/{{.component}}] event={{.event}}{{if .session}} session={{.session}}{{end}}{{if .duration_s}} duration={{.duration_s}}s{{end}}{{if .files}} files={{.files}}{{end}}{{if .bytes}} bytes={{.bytes}}{{end}} — {{.message}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ais-edge", "pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AIS Edge — Pipeline Overview",
  "uid": "ais-pipeline-overview",
  "version": 2,
  "weekStart": ""
}
