    {
      "type": "logs",
      "title": "Recent pipeline events (last 30 min)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{namespace=\"xnat-ingest\",app=\"xnat-ingest\"} | json | line_format \"[{{.component}}]{{if .session}} session={{.session}}{{end}} \u2014 {{.message}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
