  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Sessions uploaded (last 1h)",
      "description": "Count of successful session passes from `accessionflow store xnat`, matched on \"Successfully uploaded all files in\". Sessions, not files or DICOM instances; tier-1 uploads straight to XNAT and emits no per-object counters.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"upload\"} |~ \"Successfully uploaded all files in\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "Upload errors (last 1h)",
      "description": "A LINE count, not a session count: matches error/failed/exception/traceback in the upload pod's logs. One failing session can produce several lines, so read it as a trend, not a tally. Same pattern as the XNATUploadFailingForAllSessions alert.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"upload\"} |~ \"(?i)error|failed|exception|traceback\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "Invalid sessions (last 1h)",
      "description": "Count of ERROR messages beginning Could not resolve the labels of from accessionflow label xnat in the last hour. These sessions need routing-label review in assigned/__invalid__. The separate Label completed with N errors summary is excluded. A repeated attempt can report the same session again; this is not a distinct-session count.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Could not resolve the labels of .*\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Assign cycles with errors (last 1h)",
      "description": "Count of accessionflow label xnat messages beginning Label completed with N errors in the last hour. The summary is one line and records a failed cycle, regardless of how many sessions failed in it. It is not a distinct-session count. The query matches the 0.19.0 summary prefix and a numeric error count.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"assign\"} | json | message =~ \"^Label completed with [0-9]+ errors\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "Pipeline liveness (assign loop logging)",
      "description": "Distinct cluster labels seen in Loki in the last hour, excluding the management cluster. Grows by 1 each time a new edge starts shipping logs.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "(count_over_time({namespace=\"xnat-ingest\",component=\"assign\"}[1h]) > bool 0) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "logs",
      "title": "Recent invalid sessions (last 1h)",
      "description": "ERROR messages beginning Could not resolve the labels of from accessionflow label xnat. Inspect the stated missing fields and assigned/__invalid__ before correcting routing labels and retrying. A session can appear more than once. The panel uses a one-hour relative time override.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{namespace=\"xnat-ingest\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Could not resolve the labels of .*\" | line_format \"{{.cluster}} \u2014 {{.message}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "timeseries",
      "title": "Pipeline log lines per minute (by component)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (component) (count_over_time({namespace=\"xnat-ingest\",app=\"xnat-ingest\"}[1m]))",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Upload throughput (sessions/min)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"xnat-ingest\",component=\"upload\"} |~ \"Successfully uploaded all files in\" [1m]))",
