{
  "uid": "ais-edge-drilldown",
  "title": "AIS Edge — Edge Site Drilldown",
  "tags": [
    "ais-edge",
    "edge-site"
  ],
  "editable": true,
  "liveNow": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Completed uploads (last 10m, cluster=$cluster / node=$node)",
      "description": "Count of completed S3 transfer attempts in the last 10 minutes for the selected edge and node. Repeated uploads can count a session again. Zero is normal when idle and does not establish pipeline health.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",component=\"s3-uploader\"} | json | event=\"upload_completed\" [10m])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Invalid session reports (last 1h, cluster=$cluster / node=$node)",
      "description": "Count of Invalid IDs found ERROR messages from xnat-ingest assign for the selected edge and node. This excludes other assign errors. A repeated attempt can report the same session again.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",component=\"assign\"} | json | level=\"ERROR\" | message =~ \"^Invalid IDs found.*\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Upload failures (last 1h, cluster=$cluster / node=$node)",
      "description": "Count of upload_failed events from the edge s3-uploader. Check the logs for the cause; a non-zero count can reflect a transient failure that later recovered.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",component=\"s3-uploader\"} | json | event=\"upload_failed\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Unmapped AE rejection logs (last 1h, cluster=$cluster / node=$node)",
      "description": "Count of legacy Orthanc AET-map rejection log lines, not studies. In the receiver-only mode used with xnat-ingest de-identification, Orthanc returns before this lookup, so zero is expected and does not validate routing or de-identification. Legacy rejection handling preserves originals in the facility quarantine.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\",node=~\"$node\",app=\"orthanc\"} |~ \"REJECT: no project mapped for CalledAET\" [1h])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "logs",
      "title": "Live log tail — xnat-ingest pods on $cluster / $node",
      "description": "Edge pipeline log lines for the selected cluster and worker. The node dropdown is limited to the edge pipeline namespace, excluding management reclaimers that carry an edge cluster label. Raw messages are retained when JSON message is absent.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{cluster=\"$cluster\",node=~\"$node\",namespace=\"xnat-ingest\"} | json | line_format \"[{{.component}}] {{if .event}}event={{.event}} {{end}}{{if .session}}session={{.session}} {{end}}{{if .message}}{{.message}}{{else}}{{__line__}}{{end}}\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": false,
        "showLabels": false,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "type": "timeseries",
      "title": "Upload events per minute (cluster=$cluster / node=$node)",
      "description": "Structured uploader event counts per minute for the selected edge and worker. Each event type is a separate series; these counts are not unique sessions.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "links": [],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "legendFormat": "{{event}}",
          "expr": "sum by (event) (count_over_time({cluster=\"$cluster\",node=~\"$node\",component=\"s3-uploader\"} | json | event != \"\" [1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "cluster",
        "label": null,
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({namespace=\"xnat-ingest\",component=\"assign\",cluster!=\"mgmt\"}, cluster)",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "allowCustomValue": true,
        "current": {
          "text": "edge-dev",
          "value": "edge-dev"
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false
      },
      {
        "type": "query",
        "name": "node",
        "label": "Worker node",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({cluster=\"$cluster\",namespace=\"xnat-ingest\"}, node)",
        "refresh": 2,
        "sort": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "allowCustomValue": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
    ]
  }
}